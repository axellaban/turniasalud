# Copiá estas variables en Vercel → tu proyecto → Settings → Environment Variables.
# Nunca subas los valores reales a GitHub.

# Base de datos Postgres (conexión directa desde el servidor).
# Neon desde Vercel Marketplace: la integración la carga sola como DATABASE_URL.
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://usuario:contraseña@ep-ejemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ElevenLabs → Developers → API Keys (con permisos de ElevenAgents)
ELEVENLABS_API_KEY=sk_...

# Secreto del webhook post-conversación (lo da ElevenLabs al crear el webhook)
ELEVENLABS_WEBHOOK_SECRET=wsec_...

# Un texto largo y aleatorio inventado por vos. Protege las herramientas del agente y los llamados de n8n.
AGENT_TOOLS_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Contraseña para entrar al panel de la clínica
PANEL_PASSWORD=una-contraseña-segura

# Opcionales
# URL pública de la app (si no, se usa el dominio de producción de Vercel)
# APP_URL=https://turnia-salud.vercel.app
# Webhook de n8n que recibe los eventos (turno reservado, tarea creada, etc.)
# N8N_WEBHOOK_URL=https://tu-n8n.com/webhook/turnia-eventos
# LLM del agente en ElevenLabs (por defecto claude-sonnet-5-5)
# AGENT_LLM=claude-sonnet-5-5
# ID de voz de ElevenLabs (si no, se elige una voz argentina automáticamente)
# ELEVENLABS_VOICE_ID=
# Clínica por defecto (la de la demo)
# DEFAULT_CLINIC_ID=00000000-0000-4000-8000-000000000001
# Secreto para firmar la sesión del panel (por defecto usa AGENT_TOOLS_SECRET)
# SESSION_SECRET=
