# Copiá estas variables en Vercel → tu proyecto → Settings → Environment Variables.
# Nunca subas los valores reales a GitHub.

# Base de datos Postgres (conexión directa desde el servidor).
# Neon desde Vercel Marketplace: la integración la carga sola como DATABASE_URL.
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://usuario:contraseña@ep-ejemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ElevenLabs → Developers → API Keys (con permisos de ElevenAgents)
ELEVENLABS_API_KEY=sk_...

# Secreto del webhook post-conversación (lo da ElevenLabs al crear el webhook)
ELEVENLABS_WEBHOOK_SECRET=wsec_...

# Un texto largo y aleatorio inventado por vos. Protege las herramientas del agente y los llamados de n8n.
AGENT_TOOLS_SECRET=cambia-esto-por-algo-largo-y-aleatorio
# Tablero de Chapa Labs: clave de /api/metricas (32+ caracteres; el mismo valor que
# TURNIA_METRICS_SECRET en el proyecto chapa-labs de Vercel)
METRICS_SECRET=

# Contraseña para entrar al panel de la clínica
PANEL_PASSWORD=una-contraseña-segura

# WhatsApp con chip común (WAHA) + Custom Channel de ElevenLabs. Solo si elegís
# "WAHA" en Panel → Configuración. Con WhatsApp oficial de Meta no hacen falta.
# URL pública de tu WAHA (con https) y su API key
# WAHA_URL=https://waha.tu-dominio.com
# WAHA_API_KEY=
# Nombre de la sesión de WAHA (por defecto "default")
# WAHA_SESSION=default
# Clave HMAC que cargás en el webhook de la sesión de WAHA (inventala: texto largo y aleatorio)
# WAHA_WEBHOOK_HMAC=
# Los tres valores que da ElevenLabs al crear el Custom Channel del agente
# ELEVENLABS_CHANNEL_URL=https://api.elevenlabs.io/v1/convai/api-integrations/custom_channel/triggers/.../async_message
# ELEVENLABS_CHANNEL_SECRET=
# ELEVENLABS_CHANNEL_SIGNING_SECRET=
# Pausa base en milisegundos entre mensajes de una campaña por WAHA (por defecto 2000)
# WAHA_SEND_DELAY_MS=2000
# Modelo de Speech to Text para los audios (por defecto scribe_v2)
# ELEVENLABS_STT_MODEL=scribe_v2

# Opcionales
# URL pública de la app (si no, se usa el dominio de producción de Vercel)
# APP_URL=https://turnia-salud.vercel.app
# Webhook de n8n que recibe los eventos (turno reservado, tarea creada, etc.)
# N8N_WEBHOOK_URL=https://tu-n8n.com/webhook/turnia-eventos
# LLM del agente en ElevenLabs (por defecto claude-sonnet-5-5)
# AGENT_LLM=claude-sonnet-5-5
# ID de voz de ElevenLabs (si no, se elige una voz argentina automáticamente)
# ELEVENLABS_VOICE_ID=
# Clínica por defecto (la de la demo)
# DEFAULT_CLINIC_ID=00000000-0000-4000-8000-000000000001
# Secreto para firmar la sesión del panel (por defecto usa AGENT_TOOLS_SECRET)
# SESSION_SECRET=

# Audios de la web (Panel → Configuración → Audios de la web). Opcionales:
# clave aparte con permisos Text to Speech + Voices: Read (si no, usa ELEVENLABS_API_KEY)
ELEVENLABS_TTS_API_KEY=
# voces a usar en vez de las 2 favoritas de ElevenLabs
VOZ_AGENTE=
VOZ_PACIENTE=

# Para publicar aunque la base no responda en el build (no recomendado)
# SKIP_DB_MIGRATION=1

# Telegram: token privado de @TurnIA_salud_bot, únicamente en Vercel (Secret).
# Conectar bot y elegir canal desde Panel → Configuración. No cambia la conexión WAHA.
TELEGRAM_BOT_TOKEN=

# Lead magnet /probar-demo (usa el canal elegido en el panel)
# opcional: por defecto se usa el número del chip conectado a WAHA (con código de país, sin +)
DEMO_WHATSAPP_NUMBER=
# recomendado: Claude arma la ficha de la clínica a partir de la web (sin clave, perfil básico)
ANTHROPIC_API_KEY=
# Opcional: modelo para leer las fotos que mandan los pacientes (credenciales, órdenes, recetas). Por defecto, claude-opus-5-5.
# DOCUMENT_LLM=
# opcional: número de Twilio importado en ElevenLabs para que la opción "Llamada" llame al celular
ELEVENLABS_PHONE_NUMBER_ID=

# PostHog (analítica; ver ANALITICA.md). Opcionales: sin nada, usa el proyecto de Turnia Salud
# (US Cloud) y solo envía eventos en producción. Definir la clave hace que envíe también en
# local o en los previews (por ejemplo, para probar contra otro proyecto).
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
